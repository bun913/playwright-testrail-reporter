# Credentials + provisioned fixtures for the E2E run against the TestRail demo site.
# This file is generated by the /e2e-setup skill (the demo API key rotates ~weekly,
# and the demo data is wiped, so fixtures are re-created on every setup).
# Copy to `.testrail-e2e.env` (git-ignored) or let /e2e-setup create it.

TESTRAIL_E2E_URL=https://eval.testrail.techmatrix.jp
TESTRAIL_E2E_USERNAME=demo-login@example.com
TESTRAIL_E2E_API_KEY=your-rotating-demo-api-key
TESTRAIL_E2E_KEY_GENERATED_AT=2026-01-01T00:00:00Z

# Picked/created by /e2e-setup.
TESTRAIL_E2E_PROJECT_ID=1
# Only set when the project uses multiple suites (suite_mode === 3).
TESTRAIL_E2E_SUITE_ID=
# Section the fixture cases were added under.
TESTRAIL_E2E_SECTION_ID=1

# Fixtures created by /e2e-setup so both reporter use cases are exercisable:
#  - TESTRAIL_E2E_CASE_IDS: comma-separated case IDs, used in the smoke test titles.
#  - TESTRAIL_E2E_RUN_ID:   a TestRun that already contains those cases (Use Case 1).
# Leave TESTRAIL_E2E_RUN_ID empty to instead exercise Use Case 2 (reporter creates a run).
TESTRAIL_E2E_CASE_IDS=101,102
TESTRAIL_E2E_RUN_ID=1
